{
  "name": "nannylane-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Unofficial Bun-based MCP server and TypeScript SDK for authenticated Nanny Lane dashboard data.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/nannylane.ts",
    "./config": "./src/config.ts",
    "./browser-cookies": "./src/browser-cookies.ts",
    "./login": "./src/login.ts",
    "./server": "./src/server.ts"
  },
  "bin": {
    "nannylane-mcp": "./src/server.ts",
    "nannylane-mcp-login": "./src/login.ts"
  },
  "files": [
    ".env.example",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "docs",
    "scripts",
    "src",
    "test",
    "tsconfig.json"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nannylane",
    "bun",
    "stdio",
    "sdk",
    "graphql"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "login": "bun run src/login.ts",
    "login:chrome": "bun run src/login.ts --cookies-from-browser chrome",
    "login:safari": "bun run src/login.ts --cookies-from-browser safari",
    "check": "bun test && tsc --noEmit",
    "check:docs": "bun run scripts/check-doc-links.ts",
    "check:release": "bun run check && bun run check:docs && bun run smoke:mcp && bun run smoke:sdk && bun run check:secrets && bun run pack:dry-run",
    "check:secrets": "bun run scripts/check-secrets.ts",
    "pack:dry-run": "bun pm pack --dry-run --quiet",
    "smoke:mcp": "bun run scripts/mcp-smoke.ts",
    "smoke:sdk": "bun run scripts/sdk-smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.17",
    "typescript": "^6.0.3"
  }
}
