# Copy to .env locally or export these in your MCP client environment if needed.
# Do not commit real browser cookies, session ids, user ids, or Cloudflare clearance values.

# The server can start without auth so MCP clients can list tools.
# Live Nanny Lane tool calls need either NANNYLANE_COOKIE or NANNYLANE_COOKIE_FILE.
#
# Prefer NANNYLANE_COOKIE_FILE pointing outside the repository.
NANNYLANE_COOKIE=
NANNYLANE_COOKIE_FILE=/Users/you/.config/nannylane-mcp/cookie

# Optional. If omitted, the server tries to discover the current Next.js build id.
NANNYLANE_BUILD_ID=

# Optional. Used by the feature bucketing tool.
NANNYLANE_PEEKABOO_SESSION_ID=
NANNYLANE_USER_ID=
NANNYLANE_PEEKABOO_USER_KEY=

# Optional defaults.
NANNYLANE_LOCALE=en-us
NANNYLANE_TIMEOUT_MS=20000
